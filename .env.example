# ─────────────────────────────────────────────────────────────────────────────
# Canonical site URL — controls every canonical tag, og:url and sitemap entry.
# MUST be the apex domain (https://aicapitaltracker.com), NEVER a *.vercel.app
# preview domain: NEXT_PUBLIC_* values are inlined at build time, so a preview
# value here silently rewrites every canonical in the built site.
NEXT_PUBLIC_SITE_URL=https://aicapitaltracker.com

# Federal Reserve Economic Data (FRED) API Key
# Sign up free at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Alpha Vantage Market API Key
# Free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alphavantage_key_here

# Finnhub Stock & Market News API Key
# Free key at: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Adsterra ads — optional. Leave every value blank and the site renders ZERO
# ad markup: <AdSlot /> outputs nothing until a zone script is configured.
#
# Key shape: NEXT_PUBLIC_ADSTERRA_<PLACEMENT>
#   <PLACEMENT> = the placement id, uppercased, dashes as underscores.
#   Value      = the invocation script URL from your Adsterra zone.
#
# The two value shapes Adsterra serves (detected automatically from the URL —
# paste either one, no code change needed):
#
#   /21/<zoneKey>  NATIVE BANNER (4:1 widget). The zone renders into a
#                  container div it looks up BY ID, so the id matters:
#                    NEXT_PUBLIC_ADSTERRA_HOME_INFEED_1=<url>
#                    NEXT_PUBLIC_ADSTERRA_HOME_INFEED_1_ID=container-<zoneKey>
#                  The _ID value is optional — when omitted we derive Adsterra's
#                  own default (container-<zoneKey>) from the URL.
#
#   /22/<zoneKey>  CLASSIC BANNER (160x600, 728x90, 970x250…). The zone expects
#                  an `atOptions` global and then document.writes an iframe, so
#                  we render it inside an isolation <iframe> at a pinned size:
#                    NEXT_PUBLIC_ADSTERRA_MARKETS_SIDEBAR_MPU=<url>
#                  Format is auto-picked from the URL shape; only override with
#                  ..._<PLACEMENT>_SIZE=160x600 if the zone's unit is unusual.
#
# Paste your real values into .env.local (git-ignored), not here.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ADSTERRA_HOME_LEADERBOARD=
# Native banner (4:1) — /21/<zoneKey>. Optional container id override below.
NEXT_PUBLIC_ADSTERRA_HOME_INFEED_1=
NEXT_PUBLIC_ADSTERRA_HOME_INFEED_1_ID=
NEXT_PUBLIC_ADSTERRA_HOME_INFEED_2=
# Home footer band (below the model caveat). Accepts a /21/ native or /22/ banner zone.
NEXT_PUBLIC_ADSTERRA_HOME_FOOTER=
NEXT_PUBLIC_ADSTERRA_LEDGER_TOP=
NEXT_PUBLIC_ADSTERRA_LEDGER_INFEED=
NEXT_PUBLIC_ADSTERRA_COMPANIES_TOP=
NEXT_PUBLIC_ADSTERRA_COMPANIES_INFEED=
NEXT_PUBLIC_ADSTERRA_MARKETS_TOP=
# Skyscraper 160x600 — /22/<zoneKey>, rendered in an isolation iframe.
NEXT_PUBLIC_ADSTERRA_MARKETS_SIDEBAR_MPU=
NEXT_PUBLIC_ADSTERRA_METHODOLOGY_TOP=
NEXT_PUBLIC_ADSTERRA_METHODOLOGY_INFEED=
NEXT_PUBLIC_ADSTERRA_DOTCOM_TOP=
NEXT_PUBLIC_ADSTERRA_VISUALIZE_TOP=
NEXT_PUBLIC_ADSTERRA_VISUALIZE_INFEED=
NEXT_PUBLIC_ADSTERRA_SANDBOX_TOP=
NEXT_PUBLIC_ADSTERRA_API_DOCS_TOP=
NEXT_PUBLIC_ADSTERRA_GLOBAL_LEADERBOARD=
NEXT_PUBLIC_ADSTERRA_GLOBAL_INFEED=
NEXT_PUBLIC_ADSTERRA_GLOBAL_FOOTER_BILLBOARD=
# Social bar stays OFF unless this is explicitly set to 1.
NEXT_PUBLIC_ADSTERRA_SOCIAL_BAR=
NEXT_PUBLIC_ADSTERRA_SOCIAL_BAR_ENABLED=
# Kill switch: set to 1 to disable every ad slot site-wide.
NEXT_PUBLIC_ADSTERRA_DISABLED=

# ─────────────────────────────────────────────────────────────────────────────
# GitHub Actions — CI data pipeline (repo maintainers only)
#
# The `data-sync` workflow (.github/workflows/data-sync.yml) runs this exact
# pipeline headlessly once per day at 00:00 UTC. On the runner it reads the
# three API keys above from REPOSITORY SECRETS (never from this file) and
# writes them into a git-ignored .env.local before the fetch:
#
#   Settings -> Secrets and variables -> Actions -> New repository secret
#   https://github.com/1khvled/AICAPITALTRACKER/settings/secrets/actions
#
#   FRED_API_KEY
#   ALPHA_VANTAGE_API_KEY
#   FINNHUB_API_KEY
#
# The workflow fails fast BEFORE any upstream fetch if any of the three is
# missing. Paste the same values you keep in your local .env.local.
# ─────────────────────────────────────────────────────────────────────────────

