# Supabase Public Configuration (Browser safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Canonical site origin: used for sitemap.xml, robots.txt, canonical URLs and OG metadata.
NEXT_PUBLIC_SITE_URL=https://aicapitaltracker.com

# Supabase Server-Only Configuration (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Admin Bootstrap (one-time first-admin email; bypasses admin_users check for setup only.
# Create the Supabase Auth user first, sign in once, insert an admin_users row, then remove this var.)
ADMIN_BOOTSTRAP_EMAIL=admin@aicapitaltracker.com

# SEC EDGAR Official API User-Agent (Format: ProjectName/Version (ContactEmail))
SEC_USER_AGENT=AICapitalTracker/1.0 (contact@aicapitaltracker.com)

# Optional Free Public Data Source Keys (Server-only)
# Free FRED API key can be requested at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Free EIA API key can be requested at: https://www.eia.gov/opendata/register.php
EIA_API_KEY=
